    "daily_guidance": "Existing curated Daily renderer preserved; delivery now uses shared export transport.",
    "ask_export": "ask-export-v1 creates a curated bilingual reading image from the Semantic Ask result.",
    "ask_save_privacy": "Save Image always includes the complete private reading including the exact question.",
    "ask_share_privacy": "Share hides the exact question by default; user can explicitly include it. The toggle is not persisted and resets off.",
    "ask_privacy_disclosure": "UI states that the interpretation itself may still reveal the topic even when the exact question is hidden.",
    "ask_navigation": "Ask Another stays in its existing primary position below the card flow; Back to Home is added beneath as a secondary action.",
